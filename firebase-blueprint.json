{
  "entities": {
    "ContactSubmission": {
      "title": "Contact Submission",
      "description": "A submission from the contact form.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the person submitting the form."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The email address of the person."
        },
        "phone": {
          "type": "string",
          "description": "The phone number of the person."
        },
        "service": {
          "type": "string",
          "description": "The service they are interested in."
        },
        "message": {
          "type": "string",
          "description": "The message they sent."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The time the submission was created."
        }
      },
      "required": ["name", "email", "message", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "A user of the application.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email."
        },
        "role": {
          "type": "string",
          "enum": ["admin"],
          "description": "The user's role."
        }
      },
      "required": ["email", "role"]
    },
    "AdminEmail": {
      "title": "Admin Email",
      "description": "An email address authorized as an admin.",
      "type": "object",
      "properties": {
        "addedBy": {
          "type": "string",
          "description": "The UID of the admin who added this email."
        },
        "addedAt": {
          "type": "string",
          "format": "date-time",
          "description": "The time the email was added to the admin list."
        }
      },
      "required": ["addedBy", "addedAt"]
    },
    "MaltaSubmission": {
      "title": "Malta Contact Submission",
      "description": "A submission from the Malta contact form.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the person submitting the form."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The email address of the person."
        },
        "phone": {
          "type": "string",
          "description": "The phone number of the person."
        },
        "message": {
          "type": "string",
          "description": "The message they sent."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The time the submission was created."
        }
      },
      "required": ["name", "email", "message", "createdAt"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Application settings.",
      "type": "object",
      "properties": {
        "maltaTiktokEnabled": {
          "type": "boolean",
          "description": "Whether the Malta TikTok section is enabled."
        },
        "maltaTiktokUrls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The URLs of the TikTok videos for the Malta page."
        }
      }
    },
    "Project": {
      "title": "Project",
      "description": "A portfolio project.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "category": { "type": "string" },
        "location": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "images": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "features": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "slug", "category", "location", "date", "description", "images", "features", "createdAt"]
    }
  },
  "firestore": {
    "/submissions/{submissionId}": {
      "schema": "ContactSubmission",
      "description": "Collection of contact form submissions."
    },
    "/malta_submissions/{submissionId}": {
      "schema": "MaltaSubmission",
      "description": "Collection of Malta contact form submissions."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles and roles."
    },
    "/admins/{email}": {
      "schema": "AdminEmail",
      "description": "Collection of emails authorized as admins."
    },
    "/settings/{settingId}": {
      "schema": "Settings",
      "description": "Collection of application settings."
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Collection of portfolio projects."
    }
  }
}
